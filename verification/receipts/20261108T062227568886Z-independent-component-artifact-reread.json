    "argv": [
      ".venv/Scripts/python.exe",
      "-c",
      "from pathlib import Path\nimport hashlib,json,os,re,xml.etree.ElementTree as ET\nroot=Path.cwd()\npaths=['verification/receipts/20261108T060935275082Z-full-components-matrix-corrected-fixture.json','verification/receipts/20261108T060706492430Z-historical-independent-reference-current.json','verification/receipts/20261108T060855858976Z-frontend-current-contract-build.json']\ncount=0;receipts=[]\nfor name in paths:\n r=json.loads((root/name).read_text(encoding='utf-8'));receipts.append(r)\n assert r['kind']=='implementation' and r['command']['exit_code']==0\n assert not any(n.startswith(('Missing requested','Source changed')) for n in r['notes'])\n for item in r['artifacts']:\n  p=(root/item['path']).resolve();p.relative_to(root.resolve());assert not p.name.startswith('.env')\n  raw=p.read_bytes();assert len(raw)==item['bytes'] and hashlib.sha256(raw).hexdigest()==item['sha256'],item['path'];count+=1\nfull,real,build=receipts\nmatrix=[json.loads((root/a['path']).read_text()) for a in full['artifacts'] if '/strategy-matrix/' in a['path']]\nexpected={x['id'] for x in json.loads((root/'verification/catalog.json').read_text())['cases'] if x['id'].startswith('MATRIX-')}\nassert len(matrix)==120 and {x['case_id'] for x in matrix}==expected\nfor row in matrix:\n assert row['reference_parity'] and row['prefix_invariance'] and row['negative_signal_count']==0\n assert row['trade_count']>0 and row['matched_trade']['entry_quantity']>0\n assert row['signal']['id']==row['matched_trade']['id']\n assert row['signal']['available_at']==row['geometry']['available_at'] and row['signal']['side']==row['geometry']['side']\n assert abs(row['signal']['level']-row['geometry']['level'])<1e-9\n assert row['fixture_sha256']==hashlib.sha256((root/'verification/fixtures/strategy-baselines.json').read_bytes()).hexdigest()\njunit=next(a['path'] for a in full['artifacts'] if a['path'].endswith('.xml'))\ntree=ET.parse(root/junit);suites=list(tree.iter('testsuite'))\nassert sum(int(s.attrib['tests']) for s in suites)==444\nassert sum(int(s.attrib.get(k,0)) for s in suites for k in ['failures','errors','skipped'])==0\nids=set()\nfor test in tree.iter('testcase'):\n ids.update(re.findall(r'MATRIX-[^\\]]+',test.attrib['name']))\nassert ids==expected\ncomparison=json.loads((root/next(a['path'] for a in real['artifacts'] if a['path'].endswith('comparison.json'))).read_text())\ncontract=comparison['numerical_contract'];core=hashlib.sha256(json.dumps(contract,sort_keys=True,separators=(',',':'),allow_nan=False).encode()).hexdigest()\nassert comparison['core_hash']==core and all(x['core_hash']==core for x in matrix)\nfor name,digest in contract['source_files'].items(): assert hashlib.sha256((root/name).read_bytes()).hexdigest()==digest,name\nassert len(comparison['actual']['trades'])==10 and len(comparison['actual']['ledger'])==411 and len(comparison['actual']['equity'])==20\nassert max(float(x['absolute_difference']) for x in comparison['metric_comparisons'])<=1e-7\nbuilt=json.loads((root/next(a['path'] for a in build['artifacts'] if a['path'].endswith('frontend-build.json'))).read_text())\nfor name,digest in built['files'].items(): assert hashlib.sha256((root/name).read_bytes()).hexdigest()==digest,name\nresult={'scope':'Independent artifact integrity and evidence-content reread; not acceptance certification.','receipts':paths,'artifacts_checked':count,'junit_tests':444,'matrix_cases':120,'core_hash':core,'historical_trades':10,'historical_ledger_events':411,'historical_equity_points':20,'all_artifact_hashes_match':True,'current_numerical_source_matches':True,'current_built_files_match':True}\nfolder=Path(os.environ['PA_EVIDENCE_RUN_DIR']);(folder/'integrity.json').write_text(json.dumps(result,indent=2),encoding='utf-8');print(json.dumps(result,indent=2))\n"
